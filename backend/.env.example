# Server Configuration
NODE_ENV=development
PORT=5002
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Session Configuration
SESSION_SECRET=dev-insecure-session-secret-change-in-production-min-32-chars
SESSION_MAX_AGE_MS=86400000

# Application base URL (used for invitation links)
APP_BASE_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_event_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=university_event_db
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# SMTP Email Configuration (optional — if omitted, invitation links are logged to console in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@youruniversity.edu
